{
  "name": "bardo-rogue-web",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/out/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && tsx tools/check-build.ts",
    "check:build": "tsx tools/check-build.ts",
    "preview": "vite preview --port 5173 --strictPort",
    "desktop:dev": "tsc -p desktop/tsconfig.json && electron desktop/out/main.cjs",
    "desktop:build": "pnpm build && tsc -p desktop/tsconfig.json",
    "desktop:start": "BARDO_DESKTOP_MODE=packaged electron desktop/out/main.cjs",
    "desktop:dist": "pnpm desktop:build && electron-builder --mac --arm64",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "assets": "tsx tools/import-assets.ts",
    "tiles": "tsx tools/make-bardo-tiles.ts",
    "sim": "tsx tools/headless.ts",
    "shot": "tsx tools/shot.ts",
    "poses": "tsx tools/poses.ts",
    "smoke:desktop": "tsx tools/desktop-smoke.ts",
    "strip": "tsx tools/strip.ts",
    "record-bot": "tsx tools/record-bot.ts",
    "record-bots": "tsx tools/record-bot.ts --all"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "electron": "^44.0.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
