# Copy to .env.local (gitignored) and fill in. `pnpm art` loads .env.local automatically via
# node's --env-file-if-exists, so an absent file is not an error and no key is ever required
# for a dry run — every paid lane in tools/art/ is opt-in behind --live.
#
# PixelLab: https://pixellab.ai/account
PIXELLAB_SECRET=
# Retro Diffusion: https://retrodiffusion.ai
RETRODIFFUSION_SECRET=
