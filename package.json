{
  "name": "bardo-rogue-web",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/out/main.cjs",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && tsx tools/check-build.ts",
    "check:build": "tsx tools/check-build.ts",
    "preview": "vite preview --port 5173 --strictPort",
    "desktop:dev": "tsc -p desktop/tsconfig.json && electron desktop/out/main.cjs",
    "desktop:build": "pnpm build && tsc -p desktop/tsconfig.json",
    "desktop:start": "BARDO_DESKTOP_MODE=packaged electron desktop/out/main.cjs",
    "desktop:dist": "pnpm desktop:build && electron-builder --mac --arm64",
    "desktop:dist:signed-local": "pnpm desktop:build && electron-builder --mac --arm64 --config.mac.notarize=false",
    "desktop:verify": "tsx tools/verify-mac-release.ts",
    "desktop:verify:notarized": "tsx tools/verify-mac-release.ts --notarized",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "assets": "tsx tools/import-assets.ts",
    "tiles": "tsx tools/make-bardo-tiles.ts",
    "room:gate": "tsx tools/room-art-gates.ts",
    "sim": "tsx tools/headless.ts",
    "shot": "tsx tools/shot.ts",
    "poses": "tsx tools/poses.ts",
    "smoke:desktop": "tsx tools/desktop-smoke.ts",
    "strip": "tsx tools/strip.ts",
    "record-bot": "tsx tools/record-bot.ts",
    "record-bots": "tsx tools/record-bot.ts --all",
    "smoke": "tsx tools/smoke.ts",
    "matrix": "tsx tools/matrix.ts",
    "perf:sim": "tsx tools/perf-sim.ts",
    "perf:render": "tsx tools/perf-render.ts",
    "realm-air": "tsx tools/realm-air.ts",
    "art": "tsx tools/art.ts",
    "site:build": "tsx tools/build-site.ts",
    "site:deploy": "pnpm site:build && wrangler pages deploy site/dist --project-name=playbardo --branch=main",
    "palette": "tsx tools/art.ts palette",
    "fx": "tsx tools/make-bardo-fx.ts"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "electron": "^44.0.0",
    "electron-builder": "26.15.7",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
